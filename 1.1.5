#include <stdio.h>

#define MAX 20

int a[MAX], subset[MAX];
int result[1000][MAX];
int len[1000];
int count = 0;

void storeSubset(int size) {
    int i;
    len[count] = size;
    for(i = 0; i < size; i++)
        result[count][i] = subset[i];
    count++;
}

void findSubsets(int index, int n, int sum, int target, int size) {
    if(sum == target) {
        storeSubset(size);
        return;
    }

    if(index == n || sum > target)
        return;

    /* Include current element */
    subset[size] = a[index];
    findSubsets(index + 1, n, sum + a[index], target, size + 1);

    /* Exclude current element */
    findSubsets(index + 1, n, sum, target, size);
}

int main() {
    int n, target;
    int i, j;

    scanf("%d", &n);

    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &target);

    findSubsets(0, n, 0, target, 0);

    if(count == 0) {
        printf("-1");
    } else {
        for(i = count - 1; i >= 0; i--) {
            for(j = 0; j < len[i]; j++)
                printf("%d ", result[i][j]);
            printf("\n");
        }
    }

    return 0;
}

